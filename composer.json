{
    "name": "bluefission/simpleclients",
    "description": "Simple client wrappers for Blue Fission provider integrations",
    "type": "library",
    "homepage": "https://github.com/BlueFissionTech/simpleclients",
    "license": "MIT",
    "keywords": [
        "simpleclients",
        "bluefission",
        "materia",
        "php",
        "clients",
        "api",
        "http",
        "services",
        "providers",
        "transports"
    ],
    "authors": [
        {
            "name": "Devon Scott",
            "email": "dscott@bluefission.com",
            "homepage": "https://bluefission.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "bluefission/develation": "^1.3.39",
        "simplehtmldom/simplehtmldom": "^2.0@RC"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "bluefission/automata": "Enables Automata-backed LLM provider clients such as OpenAIClient.",
        "gemini-api-php/client": "Provide a Gemini SDK implementation when using GoogleGeminiClient without an injected test double."
    },
    "autoload": {
        "psr-4": {
            "BlueFission\\": "src/"
        },
        "classmap": [
           "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BlueFission\\SimpleClients\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --do-not-cache-result"
    },
    "config": {
        "platform-check": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/.codex",
            "/.github",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/AGENTS.behavior.md",
            "/AGENTS.md",
            "/ARCHITECTURE.md",
            "/CLIENT_CONTRACTS.md",
            "/PROVIDER_EXTRACTION.md",
            "/ROADMAP.md",
            "/SPEC.md",
            "/artifacts",
            "/composer.lock",
            "/docker",
            "/examples",
            "/harness.json",
            "/phpunit.xml",
            "/scripts",
            "/tests",
            "/tests.md"
        ]
    },
    "support": {
        "issues": "https://github.com/BlueFissionTech/simpleclients/issues",
        "source": "https://github.com/BlueFissionTech/simpleclients"
    }
}
